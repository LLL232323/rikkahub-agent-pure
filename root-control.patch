@@ -0,0 +1,71 @@
+package me.rerere.rikkahub.data.ai.tools.local
+
+import android.content.Context
+import android.util.Xml
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.*
+import org.xmlpull.v1.XmlPullParser
+import java.io.File
+
+/** A fresh UIAutomator dump; coordinates are snapshots and are not accessibility node handles. */
+internal suspend fun rootWindowTree(context: Context, maxNodes: Int, verbose: Boolean, packageFilter: String?): JsonObject = withContext(Dispatchers.IO) {
+    val file = File.createTempFile("root-window-", ".xml", context.cacheDir)
+    try {
+        val result = RootControl.execute(context, "uiautomator dump ${RootControl.quote(file.absolutePath)}")
+        if (result["success"]?.jsonPrimitive?.booleanOrNull != true) return@withContext result
+        if (file.length() <= 0 || file.length() > 4L * 1024 * 1024) return@withContext buildJsonObject {
+            put("error", "window_dump_unavailable"); put("reason", "empty_or_oversized_dump")
+        }
+        val nodes = mutableListOf<JsonObject>()
+        var pkg = ""
+        var seen = 0
+        var truncated = false
+        val parser = Xml.newPullParser()
+        file.inputStream().bufferedReader().use { reader ->
+        parser.setInput(reader)
+        var event = parser.eventType
+        while (event != XmlPullParser.END_DOCUMENT) {
+            if (event == XmlPullParser.START_TAG && parser.name == "node") {
+                seen++
+                fun attr(name: String) = parser.getAttributeValue(null, name).orEmpty()
+                if (pkg.isEmpty()) pkg = attr("package")
+                val text = if (attr("password") == "true") "" else attr("text")
+                val desc = attr("content-desc")
+                val clickable = attr("clickable") == "true"
+                val scrollable = attr("scrollable") == "true"
+                val bounds = Regex("\\[(\\d+),(\\d+)\\]\\[(\\d+),(\\d+)\\]").matchEntire(attr("bounds"))
+                if (bounds != null && (verbose || clickable || scrollable || text.isNotEmpty() || desc.isNotEmpty())) {
+                    if (nodes.size < maxNodes) {
+                        val b = bounds.groupValues.drop(1).map { it.toInt() }
+                        nodes.add(buildJsonObject {
+                            put("bounds", buildJsonArray { b.forEach { add(it) } })
+                            put("center", buildJsonArray { add((b[0] + b[2]) / 2); add((b[1] + b[3]) / 2) })
+                            attr("class").takeIf { it.isNotEmpty() }?.let { put("class", it) }
+                            text.takeIf { it.isNotEmpty() }?.let { put("text", it) }
+                            desc.takeIf { it.isNotEmpty() }?.let { put("content_description", it) }
+                            attr("resource-id").takeIf { it.isNotEmpty() }?.let { put("view_id", it) }
+                            if (clickable) put("clickable", true)
+                            if (scrollable) put("scrollable", true)
+                            if (attr("enabled") == "false") put("enabled", false)
+                        })
+                    } else truncated = true
+                }
+            }
+            event = parser.next()
+        }
+        }
+        if (seen == 0) return@withContext buildJsonObject { put("error", "window_dump_unavailable"); put("reason", "no_nodes") }
+        if (packageFilter != null && packageFilter != pkg) return@withContext buildJsonObject {
+            put("error", "wrong_foreground_app"); put("current", pkg); put("nodes", buildJsonArray {})
+        }
+        buildJsonObject {
+            put("success", true); put("backend", "root_uiautomator"); put("package", pkg)
+            put("total_seen", seen); put("truncated", truncated)
+            put("nodes", buildJsonArray { nodes.forEach { add(it) } })
+            put("note", "Snapshot coordinates only, no node_id. Re-read before using tap at center. UIAutomator depends on Android accessibility internals; this app's accessibility service need not be enabled. No diff or screen_state.")
+        }
+    } catch (e: Exception) {
+        buildJsonObject { put("error", "window_dump_unavailable"); put("reason", e.message ?: "parse_failed") }
+    } finally { file.delete() }
+}
