diff --git a/app/src/main/java/me/rerere/rikkahub/data/ai/tools/local/RootControl.kt b/app/src/main/java/me/rerere/rikkahub/data/ai/tools/local/RootControl.kt
new file mode 100644
index 0000000..694db7f
--- /dev/null
+++ b/app/src/main/java/me/rerere/rikkahub/data/ai/tools/local/RootControl.kt
@@ -0,0 +1,63 @@
+package me.rerere.rikkahub.data.ai.tools.local
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+import java.util.concurrent.TimeUnit
+
+/** Explicitly selected root input backend. Never falls back to accessibility on failure. */
+object RootControl {
+    const val DEFAULT_SU = "/data/PmbIWbsgEnHpoJyT/su"
+    private fun prefs(context: Context) = context.getSharedPreferences("root_control", Context.MODE_PRIVATE)
+    fun enabled(context: Context) = prefs(context).getBoolean("enabled", false)
+    fun setEnabled(context: Context, enabled: Boolean) { prefs(context).edit().putBoolean("enabled", enabled).apply() }
+    fun suPath(context: Context) = prefs(context).getString("su_path", DEFAULT_SU) ?: DEFAULT_SU
+    fun setSuPath(context: Context, path: String) { prefs(context).edit().putString("su_path", path.trim()).apply() }
+
+    suspend fun execute(context: Context, command: String): JsonObject = withContext(Dispatchers.IO) {
+        var process: Process? = null
+        try {
+            val path = suPath(context)
+            if (!path.startsWith("/") || path.contains('\n') || path.contains('\u0000')) {
+                return@withContext buildJsonObject { put("success", false); put("error", "invalid_su_path") }
+            }
+            val running = ProcessBuilder(path, "-c", "test \"$(id -u)\" = 0 && $command").redirectErrorStream(true).start()
+            process = running
+            // Drain command output to prevent a full pipe from blocking the process.
+            val output = StringBuilder()
+            val reader = Thread {
+                running.inputStream.bufferedReader().useLines { lines ->
+                    lines.forEach { line -> if (output.length < 2048) output.append(line.take(2048)).append('\n') }
+                }
+            }
+            reader.isDaemon = true
+            reader.start()
+            if (!running.waitFor(20, TimeUnit.SECONDS)) {
+                running.destroyForcibly()
+                return@withContext buildJsonObject { put("success", false); put("error", "root_timeout_or_permission_pending") }
+            }
+            reader.join(1000)
+            val code = running.exitValue()
+            buildJsonObject {
+                put("success", code == 0)
+                put("backend", "root")
+                put("exit_code", code)
+                if (code != 0) { put("error", "root_command_failed"); put("detail", output.toString().take(2048)) }
+                put("note", "Command exit status does not confirm the UI changed; screen state is unavailable in root input mode.")
+            }
+        } catch (e: Exception) {
+            buildJsonObject { put("success", false); put("error", "root_start_failed"); put("detail", e.message ?: e.javaClass.simpleName) }
+        } finally { process?.destroy() }
+    }
+
+    suspend fun input(context: Context, points: List<Pair<Double, Double>>, command: String): JsonObject {
+        val dm = context.resources.displayMetrics
+        if (points.any { coordsOutOfBounds(it.first, it.second, dm.widthPixels, dm.heightPixels) }) {
+            return buildJsonObject { put("error", "out_of_bounds"); put("display", buildJsonObject { put("w", dm.widthPixels); put("h", dm.heightPixels) }) }
+        }
+        return execute(context, command)
+    }
+}
